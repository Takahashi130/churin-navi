# --- Google Maps Platform ---
# ブラウザ用（Maps JavaScript API）。HTTPリファラ制限をかけること。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# 任意: Cloud Console で作った Map ID（未設定なら DEMO_MAP_ID を使用）
NEXT_PUBLIC_GOOGLE_MAP_ID=
# サーバー用（Places API (New)）。ブラウザには出さない。API制限で Places API (New) のみに絞ること。
GOOGLE_PLACES_API_KEY=

# --- OpenStreetMap (Overpass) ---
# 連絡先を含む User-Agent を推奨（Overpass の利用マナー）
OVERPASS_USER_AGENT=churin-navi/0.1 (personal use)

# --- 現地確認の登録・要望送信（任意） ---
# fine-grained token: リポジトリ churin-navi のみ / Contents: Read and write / Issues: Read and write
GITHUB_TOKEN=
# 書き込みの合言葉（自分で決める）
APP_PASSCODE=
